%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>  
#include "cactus.tab.h"  /* header generated by Bison */   
%}

/* Flex 內建lint靜態程式檢查追蹤語法 */
%option yylineno
%option noyywrap
/* 這一塊 宣告巨集 e.g. DIGIT    [0-9] */

%%
[ \t\r\n]+              { /* Ignore */ }                   
       
"//".*                { /* Ignore */ }
                     

"Program"             { return PROGRAM; } /* Keyword */
"Begin"               { return BEGIN_TOK; }  /*BEGIN為bison關鍵字不能用 */
"End"                 { return END; }
"Var"                 { return VAR; }
"Set"                 { return SET; }
"If"                  { return IF; }
"Then"                { return THEN; }
"Else"                { return ELSE; }
"EndIf"               { return ENDIF; }
"While"               { return WHILE; }
"Do"                  { return DO; }
"EndWhile"            { return ENDWHILE; }
"Read"                { return READ; }
"Write"               { return WRITE; }
"Exit"                { return EXIT; }
"Or"                  { return OR; }
"And"                 { return AND; }
"Not"                 { return NOT; }


"=="                  { return EQ; } /* Operator */ 
"<>"                  { return NE; }
"<="                  { return LE; }
">="                  { return GE; }
"<"                   { return LT; }  
">"                   { return GT; }
"+"                   { return ADD; }
"-"                   { return SUB; }
"*"                   { return MUL; }
"/"                   { return DIV; }
"%"                   { return MOD; }
"="                   { return ASSIGN; }
"("                   { return LPAREN; }
")"                   { return RPAREN; }




[0-9]+                { yylval.intval = atoi(yytext); return CONST; }  /* to integer */
[a-zA-Z_][a-zA-Z0-9_]* { yylval.id = strdup(yytext); return ID; } /* Identifiers and Constants */




.                     { /* Bison handler error case, Ignore */ } 
%%