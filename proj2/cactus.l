%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>  
#include "cactus.tab.h"  /* header generated by Bison */   
%}

/* Flex 內建lint靜態程式檢查追蹤語法 */
%option yylineno
%option noyywrap
/* 這一塊 宣告巨集 e.g. DIGIT    [0-9] */

%%
[ \t\r\n]+              { /* Ignore */ }                   
       
"//".*                { /* Ignore */ }
                     

"Program"             { return Program; } /* Keyword */
"Begin"               { return Begin; }
"End"                 { return End; }
"Var"                 { return Var; }
"Set"                 { return Set; }
"If"                  { return If; }
"Then"                { return Then; }
"Else"                { return Else; }
"EndIf"               { return EndIf; }
"While"               { return While; }
"Do"                  { return Do; }
"EndWhile"            { return EndWhile; }
"Read"                { return Read; }
"Write"               { return Write; }
"Exit"                { return Exit; }
"Or"                  { return Or; }
"And"                 { return And; }
"Not"                 { return Not; }


"=="                  { return EQ; } /* Operator */ 
"<>"                  { return NE; }
"<="                  { return LE; }
">="                  { return GE; }
"<"                   { return LT; }  
">"                   { return GT; }
"+"                   { return PLUS; }
"-"                   { return MINUS; }
"*"                   { return MULT; }
"/"                   { return DIV; }
"%"                   { return MOD; }
"="                   { return ASSIGN; }
"("                   { return LPAREN; }
")"                   { return RPAREN; }




[0-9]+                { yylval.intval = atoi(yytext); return IntConst; }  /* to integer */
[a-zA-Z_][a-zA-Z0-9_]* { yylval.id = strdup(yytext); return Identifier; } /* Identifiers and Constants */




.                     { /* Bison handler error case, Ignore */ } 
%%